{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "installCommand": "yarn install --frozen-lockfile",
  "buildCommand": "yarn build",
  "rewrites": [
    {"source": "/auth/:path*", "destination": "https://my-space-service.vercel.app/auth/:path*"},
    {"source": "/api/my-space", "destination": "https://my-space-service.vercel.app/api/my-space"},
    {"source": "/api/my-space/:path*", "destination": "https://my-space-service.vercel.app/api/my-space/:path*"},
    {"source": "/api/directory", "destination": "https://my-space-service.vercel.app/api/directory"},
    {"source": "/api/teams", "destination": "https://my-space-service.vercel.app/api/teams"},
    {"source": "/api/email-relay", "destination": "https://my-space-service.vercel.app/api/email-relay"},
    {"source": "/api/interests", "destination": "https://my-space-service.vercel.app/api/interests"},
    {"source": "/api/interests/:path*", "destination": "https://my-space-service.vercel.app/api/interests/:path*"},
    {"source": "/verify-email", "destination": "https://my-space-service.vercel.app/verify-email"},
    {"source": "/verify.js", "destination": "https://my-space-service.vercel.app/verify.js"},
    {"source": "/admin", "destination": "https://my-space-service.vercel.app/admin"},
    {"source": "/admin.js", "destination": "https://my-space-service.vercel.app/admin.js"},
    {"source": "/admin/:path*", "destination": "https://my-space-service.vercel.app/admin/:path*"}
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
